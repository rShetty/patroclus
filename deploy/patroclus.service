[Unit]
Description=Patroclus Authorization Infrastructure
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=patroclus
Group=patroclus
EnvironmentFile=/etc/patroclus/patroclus.env
ExecStart=/usr/local/bin/patroclus serve --config /etc/patroclus/patroclus.toml
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/patroclus /etc/patroclus/keys
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
